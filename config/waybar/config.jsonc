[
  {
    "name": "raiz",
    "layer": "top",
    "position": "left",
    "width": 56,
    "spacing": 6,
    "modules-left": [
      "custom/apps",
      "custom/archivos",
      "custom/seguridad",
      "custom/portapapeles",
      "custom/camara",
      "custom/notificaciones",
      "custom/captura",
      "custom/asistente",
      "custom/juego",
      "custom/config"
    ],
    "custom/seguridad": {
      "exec": "leksso-auditoria riel",
      "return-type": "json",
      "interval": 120,
      "on-click": "leksso-seguridad --conexiones"
    },
    "custom/archivos": {
      "format": "",
      "tooltip-format": "Plegar o desplegar las carpetas (Súper+E)",
      "on-click": "leksso-zonas --plegar"
    },
    "custom/juego": {
      "exec": "leksso-juego barra",
      "return-type": "json",
      "interval": 30,
      "signal": 9,
      "on-click": "leksso-juego"
    },
    "custom/camara": {
      "format": "",
      "tooltip-format": "Cámara y micrófono",
      "on-click": "leksso-dispositivos"
    },
    "custom/notificaciones": {
      "format": "",
      "tooltip-format": "Notificaciones",
      "on-click": "leksso-notificaciones"
    },
    "custom/captura": {
      "format": "",
      "tooltip-format": "Captura de pantalla: elige una zona (Imprimir)",
      "on-click": "leksso-captura region"
    },
    "custom/config": {
      "format": "",
      "tooltip-format": "Ajustes",
      "on-click": "leksso-ajustes"
    },
    "modules-right": [
      "custom/flotantes",
      "custom/energia"
    ],
    "custom/apps": {
      "format": "",
      "tooltip-format": "Aplicaciones",
      "on-click": "leksso-menu"
    },
    "custom/energia": {
      "format": "",
      "tooltip-format": "Apagar, suspender, hibernar…",
      "on-click": "leksso-energia"
    },
    "custom/asistente": {
      "format": "",
      "tooltip-format": "Asistentes de IA (clic derecho: ajustes y permisos)",
      "on-click": "leksso-asistentes abrir",
      "on-click-right": "leksso-asistentes"
    },
    "custom/flotantes": {
      "format": "",
      "tooltip-format": "Minimizar: ocultar o mostrar las ventanas flotantes",
      "on-click": "leksso-flotantes"
    },
    "custom/portapapeles": {
      "format": "",
      "tooltip-format": "Historial del portapapeles (Mod+V)",
      "on-click": "leksso-portapapeles"
    }
  },
  {
    "name": "tareas",
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 0,
    "modules-left": [
      "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
      "custom/actualizacion",
      "custom/copias",
      "custom/ia",
      "custom/dispositivos",
      "cpu",
      "memory",
      "pulseaudio",
      "network",
      "custom/bateria",
      "clock"
    ],
    "wlr/taskbar": {
      "format": "{icon} {title:.26}",
      "ignore-list": ["Operativa usuario", "Panel de la IA", "Carpetas"],
      "icon-size": 18,
      "all-outputs": true,
      "on-click": "activate",
      "on-click-middle": "close",
      "tooltip-format": "{title} (clic central: cerrar)",
      "max-length": 22
    },
    "custom/ia": {
      "exec": "python3 /usr/local/lib/leksso-ia/modelo.py estado",
      "on-click": "leksso-panel-ia",
      "return-type": "json",
      "interval": 30
    },
    "custom/bateria": {
      "exec": "leksso-barra-bateria",
      "return-type": "json",
      "interval": 10,
      "signal": 10,
      "hide-empty-text": true,
      "on-click": "leksso-barra-perfil menu"
    },
    "cpu": {
      "format": " {usage:>2}%",
      "tooltip-format": "Procesador al {usage}%",
      "interval": 3,
      "states": {
        "warning": 70,
        "critical": 90
      }
    },
    "memory": {
      "format": " {percentage:>2}%",
      "tooltip-format": "Memoria: {used:0.1f} de {total:0.1f} GB en uso",
      "interval": 3,
      "states": {
        "warning": 75,
        "critical": 90
      }
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "default": ["", "", ""]
      },
      "format-muted": " silencio",
      "tooltip-format": "{desc}\nVolumen {volume}%",
      "scroll-step": 5,
      "on-click": "pavucontrol-qt",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
      "format-ethernet": " Cable",
      "format-wifi": " {icon}",
      "format-icons": ["▂", "▄", "▆", "█"],
      "format-disconnected": " Sin red",
      "tooltip-format-ethernet": "Cable · {ifname}\nIP {ipaddr}\nPuerta de enlace {gwaddr}",
      "tooltip-format-wifi": "Wi-Fi: {essid}\nSeñal {signalStrength}%\nIP {ipaddr}",
      "tooltip-format-disconnected": "Sin conexión",
      "on-click": "leksso-term -T \"Redes\" -e leksso-redes"
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:%A %d de %B de %Y}\nClic para ver el calendario y los festivos",
      "on-click": "leksso-calendario"
    },
    "custom/dispositivos": {
      "exec": "leksso-dispositivos barra",
      "return-type": "json",
      "interval": 3,
      "signal": 12,
      "hide-empty-text": true,
      "on-click": "leksso-dispositivos"
    },
    "custom/copias": {
      "exec": "leksso-copias barra",
      "return-type": "json",
      "interval": 600,
      "hide-empty-text": true,
      "on-click": "leksso-copias-ui"
    },
    "custom/actualizacion": {
      "exec": "leksso-actualizar barra",
      "return-type": "json",
      "interval": 300,
      "signal": 11,
      "hide-empty-text": true,
      "on-click": "leksso-actualizaciones"
    }
  }
]
