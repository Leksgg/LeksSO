    bloque para entrar; al pie, el sistema y su versión. Los identificadores que usa gtklock se conservan todos."""
    s, u = escape(sistema), escape(usuario)
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="window-box">
    <property name="name">window-box</property>
    <property name="margin">96</property>
    <property name="halign">fill</property>
    <property name="valign">fill</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox" id="columna">
        <property name="name">columna</property>
        <property name="visible">1</property>
        <property name="halign">start</property>
        <property name="valign">center</property>
        <property name="vexpand">1</property>
        <property name="orientation">vertical</property>
