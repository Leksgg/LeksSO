              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="sistema-label">
            <property name="name">sistema-label</property>
            <property name="visible">1</property>
            <property name="halign">start</property>
            <property name="xalign">0</property>
            <property name="label">{s}</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
"""


def nombre_sistema():
    """«LeksSO Beta 0.1.45», o solo «LeksSO» si no se puede leer la versión."""
    try:
        r = subprocess.run(["leksso-actualizar", "version"], capture_output=True, text=True, timeout=10)
        t = r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else ""
    except (OSError, subprocess.SubprocessError):
        t = ""
    return t if t.startswith("LeksSO") else "LeksSO"


def estilo_del_tema():
    try:
        from leksso_ui import pintar
        return pintar(ESTILO)
    except Exception:
        return ESTILO


def ya_bloqueado():
    for prog in ("gtklock", "swaylock"):
        try:
            if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", prog], capture_output=True).returncode == 0:
                return True
        except OSError:
            pass
    return False


def ventana_con_foco():
    """El número (de sway) de la ventana que tiene el teclado ahora, o None."""
    try:
        import json
        r = subprocess.run(["swaymsg", "-t", "get_tree"], capture_output=True, text=True, timeout=5)
        arbol = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None

    def buscar(n):
        if n.get("focused") and n.get("type") in ("con", "floating_con"):
            return n.get("id")
        for h in n.get("nodes", []) + n.get("floating_nodes", []):
            r = buscar(h)
            if r is not None:
                return r
        return None
    return buscar(arbol)


def orden_gtklock(ruta_diseno, ruta_estilo, foco=None):
    orden = ["gtklock", "--daemonize", "--layout", ruta_diseno, "--style", ruta_estilo,
             "--time-format", "%H:%M", "--date-format", "%A %d de %B"]
    if isinstance(foco, int):
        # al desbloquear, el teclado vuelve a la ventana que lo tenía (si no, a veces se queda sin ninguna)
        orden += ["--unlock-command", f"swaymsg [con_id={foco}] focus"]
    return orden


def bloquear():
    if ya_bloqueado():
        return 0
    try:                                # con la pantalla bloqueada no se comparte: se corta antes de bloquear
        subprocess.run(["leksso-pantalla", "cortar", "--silencio"], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass
    if shutil.which("gtklock"):
        try:
            carpeta = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "leksso-bloqueo")
            os.makedirs(carpeta, mode=0o700, exist_ok=True)
            rd, re_ = os.path.join(carpeta, "diseno.ui"), os.path.join(carpeta, "estilo.css")
            with open(rd, "w", encoding="utf-8") as f:
                f.write(diseno(nombre_sistema(), getpass.getuser()))
            with open(re_, "w", encoding="utf-8") as f:
                f.write(estilo_del_tema())
            if subprocess.run(orden_gtklock(rd, re_, ventana_con_foco()), timeout=20).returncode == 0:
                return 0
        except (OSError, subprocess.SubprocessError):
            pass
        if ya_bloqueado():              # arrancó pero tardó en avisar: ya está bloqueado, no se pone otro encima
            return 0
    # respaldo: el bloqueo de antes
    return subprocess.run(["swaylock", "-f"]).returncode


def main(a):
    if a == ["--diseno"]:
        print(diseno(nombre_sistema(), getpass.getuser()))
        return 0
    if not a:
        return bloquear()
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
