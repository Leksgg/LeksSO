#!/usr/bin/env python3
"""Calendario de consulta de LeksSO: el mes, el día de hoy y los festivos de Madrid. Solo se mira: no guarda ni cambia nada.

  leksso-calendario                 abre la ventana (un clic en el reloj de la barra; otro clic la cierra)
  leksso-calendario --mes 2026-12   abre ese mes
  leksso-calendario --captura F.png [--mes AAAA-MM]   guarda una imagen de la ventana y sale (para revisar el diseño)

Los festivos están en /usr/local/share/leksso/festivos.json (año a año). Si un año no está cargado, la ventana lo dice en vez de
enseñar un mes sin festivos como si no hubiera ninguno. Se cierra con la X, con Esc o al hacer clic fuera.
Teclado: ← y → (o Re Pág y Av Pág) cambian de mes; Inicio vuelve a hoy.
"""
import datetime
import json
import os
import sys

AQUI = os.path.dirname(os.path.abspath(__file__))
MESES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"]
DIAS = ["L", "M", "X", "J", "V", "S", "D"]
AMBITOS = {"nacional": "Nacional", "comunidad": "Comunidad de Madrid", "local": "Madrid capital"}
RUTAS = [os.environ.get("LEKSSO_FESTIVOS", ""), "/usr/local/share/leksso/festivos.json",
         os.path.join(AQUI, "..", "calendario", "festivos.json")]


# ---------- lógica (sin ventana, para poder probarla) ----------
def cargar(rutas=None):
    """Datos de festivos: {año (texto): {...}} o {} si no hay archivo legible."""
    for r in (rutas if rutas is not None else RUTAS):
        if not r or not os.path.exists(r):
            continue
        try:
            with open(r, encoding="utf-8") as f:
                return json.load(f).get("anios", {})
        except (OSError, ValueError):
            continue
    return {}


def festivos_del_anio(datos, anio):
    """{fecha: (nombre, ámbito)} de un año; vacío si no está cargado."""
    res = {}
    for f in datos.get(str(anio), {}).get("festivos", []):
        try:
            res[datetime.date.fromisoformat(f["fecha"])] = (f["nombre"], f.get("ambito", "nacional"))
        except (KeyError, ValueError):
            continue
    return res


def estado_anio(datos, anio):
    """('ausente'|'incompleto'|'completo', nota): lo que hay que decir sobre los festivos de ese año."""
    d = datos.get(str(anio))
    if not d:
        return "ausente", f"Todavía no tengo cargados los festivos de {anio}."
    if d.get("completo", True):
        return "completo", ""
    return "incompleto", d.get("nota", "La lista de este año puede estar incompleta.")


def rejilla(anio, mes):
    """42 fechas (6 semanas, de lunes a domingo) que cubren el mes."""
    primero = datetime.date(anio, mes, 1)
    ini = primero - datetime.timedelta(days=primero.weekday())
    return [ini + datetime.timedelta(days=i) for i in range(42)]


def mes_vecino(anio, mes, delta):
    n = anio * 12 + (mes - 1) + delta
    return n // 12, n % 12 + 1


def festivos_del_mes(datos, anio, mes):
    """[(fecha, nombre, ámbito)] de ese mes, en orden."""
    fs = festivos_del_anio(datos, anio)
    return sorted((d, n, a) for d, (n, a) in fs.items() if d.month == mes)


def nombre_dia(d):
    return ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"][d.weekday()]


# ---------- ventana ----------
def ventana(anio, mes, captura=None):
    for ruta in ("/usr/local/lib/leksso-ui", os.path.join(AQUI, "..", "ui")):
        if ruta not in sys.path:
            sys.path.insert(0, ruta)
    from PySide6 import QtCore, QtWidgets
    from leksso_ui import ESTILO_BASE, alternar, estilo, pintar

    if captura is None and alternar("leksso-calendario"):     # un segundo clic en el reloj la cierra
        return 0
    datos = cargar()
    hoy = datetime.date.today()

    class Calendario(QtWidgets.QWidget):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("Calendario")
            estilo(self, ESTILO_BASE)
            self.anio, self.mes = anio, mes
            self.tuvo_foco = False
            raiz = QtWidgets.QVBoxLayout(self)
            raiz.setContentsMargins(14, 10, 14, 14)
            raiz.setSpacing(8)
            cab = QtWidgets.QHBoxLayout()
            t = QtWidgets.QLabel("Calendario")
            t.setObjectName("titulo")
            cab.addWidget(t)
            cab.addStretch()
            x = QtWidgets.QPushButton("✕")
            x.setObjectName("cerrar")
            x.setToolTip("Cerrar (Esc)")
            x.clicked.connect(self.close)
            cab.addWidget(x)
            raiz.addLayout(cab)
            nav = QtWidgets.QHBoxLayout()
            self.ant = self.boton("‹", "Mes anterior (←)", lambda: self.ir(-1))
            self.sig = self.boton("›", "Mes siguiente (→)", lambda: self.ir(1))
            self.titulo_mes = QtWidgets.QLabel("")
            self.titulo_mes.setAlignment(QtCore.Qt.AlignCenter)
            self.titulo_mes.setStyleSheet(pintar("font-size: 17px; font-weight: bold; color: #e3edef;"))
            self.boton_hoy = self.boton("Hoy", "Volver al mes de hoy (Inicio)", self.ir_a_hoy)
            nav.addWidget(self.ant)
            nav.addWidget(self.titulo_mes, 1)
            nav.addWidget(self.sig)
            nav.addWidget(self.boton_hoy)
            raiz.addLayout(nav)
            malla = QtWidgets.QGridLayout()
            malla.setSpacing(3)
            for i, d in enumerate(DIAS):
                e = QtWidgets.QLabel(d)
                e.setAlignment(QtCore.Qt.AlignCenter)
                e.setStyleSheet(pintar("color: #94a1a3; font-size: 12px; font-weight: bold;"))
                malla.addWidget(e, 0, i)
            self.celdas = []
            for f in range(6):
                for c in range(7):
                    e = QtWidgets.QLabel("")
                    e.setAlignment(QtCore.Qt.AlignCenter)
                    e.setMinimumSize(44, 34)
                    malla.addWidget(e, f + 1, c)
                    self.celdas.append(e)
            raiz.addLayout(malla)
            self.lista = QtWidgets.QLabel("")
            self.lista.setWordWrap(True)
            self.lista.setTextFormat(QtCore.Qt.RichText)
            self.lista.setAlignment(QtCore.Qt.AlignTop | QtCore.Qt.AlignLeft)
            raiz.addWidget(self.lista, 1)
            self.nota = QtWidgets.QLabel("")
            self.nota.setObjectName("nota")
            self.nota.setWordWrap(True)
            raiz.addWidget(self.nota)
            self.pintar_mes()

        def boton(self, texto, ayuda, accion):
            b = QtWidgets.QPushButton(texto)
            b.setToolTip(ayuda)
            b.setFocusPolicy(QtCore.Qt.NoFocus)
            b.setStyleSheet(pintar("QPushButton { background: #112123; border: 1px solid #25393c; padding: 4px 12px; font-size: 15px; }"
                                   "QPushButton:hover { background: #003635; border: 1px solid #00c4bf; }"))
            b.clicked.connect(accion)
            return b

        def ir(self, delta):
            self.anio, self.mes = mes_vecino(self.anio, self.mes, delta)
            self.pintar_mes()

        def ir_a_hoy(self):
            self.anio, self.mes = hoy.year, hoy.month
            self.pintar_mes()

        def pintar_mes(self):
            self.titulo_mes.setText(f"{MESES[self.mes - 1]} {self.anio}")
            fest = {}
            # los días de las semanas de relleno pueden ser de otro año: se miran los dos años que toca la rejilla
            for a in {self.anio - 1, self.anio, self.anio + 1}:
                fest.update(festivos_del_anio(datos, a))
            for e, d in zip(self.celdas, rejilla(self.anio, self.mes)):
                dentro = d.month == self.mes
                es_fest = d in fest
                color = "#e3edef" if dentro else "#667576"
                fondo = "transparent"
                borde = "1px solid transparent"
                peso = "normal"
                if d.weekday() >= 5 and dentro:
                    color = "#94a1a3"
                if es_fest:
                    color = "#fdc357" if dentro else "#667576"
                    fondo = "#332305" if dentro else "transparent"
                    peso = "bold"
                if d == hoy:
                    fondo = "#003635"
                    borde = "2px solid #00c4bf"
                    if not es_fest:
                        color = "#e3edef"
                e.setText(str(d.day))
                e.setStyleSheet(pintar(f"background: {fondo}; color: {color}; border: {borde}; font-weight: {peso}; font-size: 14px;"))
                e.setToolTip(f"{fest[d][0]}" if es_fest else "")
            lineas = []
            for d, nombre, ambito in festivos_del_mes(datos, self.anio, self.mes):
                lineas.append(f"<span style='color:#fdc357'><b>{d.day}</b></span> {nombre_dia(d)} · {nombre} "
                              f"<span style='color:#94a1a3'>({AMBITOS.get(ambito, ambito)})</span>")
            estado, aviso = estado_anio(datos, self.anio)
            if lineas:
                self.lista.setText(pintar("<br>".join(lineas)))
            elif estado == "ausente":
                self.lista.setText(pintar("<span style='color:#94a1a3'>Sin datos de festivos para este año.</span>"))
            else:
                self.lista.setText(pintar("<span style='color:#94a1a3'>Sin festivos este mes.</span>"))
            self.nota.setText(aviso if estado != "completo" else "Festivos de Madrid: nacionales, de la Comunidad y de Madrid capital.")

        def keyPressEvent(self, ev):
            k = ev.key()
            if k == QtCore.Qt.Key_Escape:
                self.close()
            elif k in (QtCore.Qt.Key_Left, QtCore.Qt.Key_PageUp):
                self.ir(-1)
            elif k in (QtCore.Qt.Key_Right, QtCore.Qt.Key_PageDown):
                self.ir(1)
            elif k == QtCore.Qt.Key_Home:
                self.ir_a_hoy()
            else:
                super().keyPressEvent(ev)

        def changeEvent(self, ev):
            # al perder el foco (clic fuera) se cierra, salvo al principio, cuando aún no lo había recibido
            if ev.type() == QtCore.QEvent.ActivationChange and captura is None:
                if self.tuvo_foco and not self.isActiveWindow():
                    self.close()
                elif self.isActiveWindow():
                    self.tuvo_foco = True
            super().changeEvent(ev)

    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-calendario")
    w = Calendario()
    w.resize(380, 520)
    if captura:
        w.show()
        app.processEvents()
        w.grab().save(captura)
        return 0
    w.show()
    return app.exec()


def main(argv):
    anio, mes = datetime.date.today().year, datetime.date.today().month
    captura = None
    i = 0
    while i < len(argv):
        if argv[i] == "--mes" and i + 1 < len(argv):
            try:
                anio, mes = (int(x) for x in argv[i + 1].split("-"))
                datetime.date(anio, mes, 1)
            except ValueError:
                print("El mes se escribe así: --mes 2026-12", file=sys.stderr)
                return 2
            i += 2
        elif argv[i] == "--captura" and i + 1 < len(argv):
            captura = argv[i + 1]
            i += 2
        else:
            print(__doc__)
            return 2
    return ventana(anio, mes, captura)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
