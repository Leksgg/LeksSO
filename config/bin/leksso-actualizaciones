#!/usr/bin/env python3
"""Actualizaciones de LeksSO: qué versión tienes, si hay una nueva y qué cambia.

Instalar pide tu contraseña en una terminal, para que veas lo que pasa. LeksSO solo se instala con tu permiso.
Sistema y controladores: los paquetes de Debian, el microcódigo y el firmware se actualizan solos una vez al día; con
«Actualizar sistema y controladores» se pone todo al día en el momento (también NVIDIA y el firmware de dispositivos,
que piden confirmación). De la BIOS dice qué versión hay y si el equipo admite actualizarla desde aquí.
Se cierra con la X o con Esc.
"""
import json
import os
import subprocess
import sys

from PySide6 import QtCore, QtWidgets

sys.path.insert(0, "/usr/local/lib/leksso-ui")
from leksso_ui import ESTILO_BASE, alternar, confirmar, estilo  # noqa: E402


def sal(*cmd, tiempo=40):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=tiempo)
        return r.stdout.strip() or r.stderr.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def estado_hw():
    try:
        return json.load(open("/var/lib/leksso/hardware.json", encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def clave_secure_boot():
    """Estado de la clave de firma de controladores: registrada, pendiente, sin-registrar, sin-clave o no-necesaria."""
    try:
        return json.loads(sal("leksso-actualizar", "hardware", "mok")).get("clave", "")
    except ValueError:
        return ""


def resumen_hw(est):
    """(texto en lenguaje llano, ¿hay algo que instalar con un clic?)"""
    if not est:
        return "Todavía no se ha comprobado. Se hace sola cada día, a los 3 minutos de arrancar.", False
    lineas, pendiente = [], False
    n = est.get("nvidia")
    if n and n.get("accion") == "instalar":
        lineas.append("Tu tarjeta NVIDIA puede usar el controlador oficial (software propietario). Da más rendimiento en juegos.")
        if est.get("secure_boot"):
            lineas.append("Tu equipo tiene Secure Boot: primero se registra una clave de firma (una sola vez, con una contraseña que eliges tú) y se reinicia; después se instala el controlador.")
        pendiente = True
    elif n and n.get("accion") == "actualizar":
        lineas.append(f"Hay un controlador NVIDIA más nuevo ({n.get('candidato', '')}).")
        pendiente = True
    for f in est.get("firmware", []):
        lineas.append(f"Actualización de firmware: {f.get('dispositivo', '')} {f.get('version', '')}.")
        pendiente = True
    paquetes = est.get("paquetes") if isinstance(est.get("paquetes"), int) else 0
    if paquetes:
        lineas.insert(0, f"Hay {paquetes} actualizaciones del sistema por instalar." if paquetes != 1
                      else "Hay 1 actualización del sistema por instalar.")
        pendiente = True
    if not lineas:
        lineas.append("Sistema, controladores y firmware al día. Se comprueba solo una vez al día.")
    b = est.get("bios") or {}
    if b.get("texto"):
        if b.get("por_fwupd") is True:
            lineas.append(f"BIOS: {b['texto']}. Este equipo admite actualizarla desde aquí, pero hoy el fabricante no ofrece ninguna más nueva por esta vía. Para confirmarlo, mira su web de soporte.")
        elif b.get("por_fwupd") is False:
            lineas.append(f"BIOS: {b['texto']}. Este equipo no la recibe por aquí: se mira en la web de soporte del fabricante.")
        else:
            lineas.append(f"BIOS: {b['texto']}.")
    return "\n".join(lineas), pendiente


def cache():
    try:
        return json.load(open(os.path.expanduser("~/.cache/leksso/actualizacion.json"), encoding="utf-8"))
    except (OSError, ValueError):
        return {}


class Trabajo(QtCore.QThread):
    listo = QtCore.Signal(str, str)

    def __init__(self, orden, etiqueta):
        super().__init__()
        self.orden, self.etiqueta = orden, etiqueta

    def run(self):
        self.listo.emit(self.etiqueta, sal(*self.orden))


class Ventana(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Actualizaciones")
        estilo(self, ESTILO_BASE)
        raiz = QtWidgets.QVBoxLayout(self)
        raiz.setContentsMargins(14, 10, 14, 14)
        cab = QtWidgets.QHBoxLayout()
        t = QtWidgets.QLabel("Actualizaciones")
        t.setObjectName("titulo")
        cab.addWidget(t)
        cab.addStretch()
        x = QtWidgets.QPushButton("✕")
        x.setObjectName("cerrar")
        x.setToolTip("Cerrar (Esc)")
        x.clicked.connect(self.close)
        cab.addWidget(x)
        raiz.addLayout(cab)
        self.actual = QtWidgets.QLabel()
        self.actual.setStyleSheet("font-size: 18px; font-weight: bold;")
        raiz.addWidget(self.actual)
        self.huella = QtWidgets.QLabel()
        self.huella.setObjectName("nota")
        self.huella.setTextInteractionFlags(QtCore.Qt.TextSelectableByMouse)
        raiz.addWidget(self.huella)
        self.estado = QtWidgets.QLabel()
        self.estado.setWordWrap(True)
        raiz.addWidget(self.estado)
        self.cambios = QtWidgets.QTextBrowser()      # las notas vienen en Markdown: se enseñan con formato
        self.cambios.setReadOnly(True)
        self.cambios.setPlaceholderText("Aquí aparece lo que trae la versión nueva.")
        raiz.addWidget(self.cambios, 1)
        t_hw = QtWidgets.QLabel("Sistema y controladores")
        t_hw.setObjectName("titulo")
        raiz.addWidget(t_hw)
        self.hw = QtWidgets.QLabel()
        self.hw.setWordWrap(True)
        raiz.addWidget(self.hw)
        self.b_hw = QtWidgets.QPushButton("Actualizar sistema y controladores")
        self.b_hw.setObjectName("accion")
        self.b_hw.clicked.connect(self.instalar_hw)
        raiz.addWidget(self.b_hw)
        fila = QtWidgets.QHBoxLayout()
        self.b_comprobar = QtWidgets.QPushButton("Buscar versión nueva")
        self.b_comprobar.setObjectName("accion")
        self.b_comprobar.clicked.connect(self.comprobar)
        self.b_instalar = QtWidgets.QPushButton("Actualizar ahora")
        self.b_instalar.setObjectName("principal")
        self.b_instalar.clicked.connect(self.instalar)
        self.b_volver = QtWidgets.QPushButton("Volver a la anterior")
        self.b_volver.setObjectName("peligro")
        self.b_volver.clicked.connect(self.volver)
        for b in (self.b_comprobar, self.b_instalar, self.b_volver):
            fila.addWidget(b)
        raiz.addLayout(fila)
        nota = QtWidgets.QLabel("Solo se instalan versiones firmadas por LeksSO. Se te pide la contraseña en una terminal. "
                                "El microcódigo y el firmware de Debian se actualizan solos; el resto, con tu clic.")
        nota.setObjectName("nota")
        nota.setWordWrap(True)
        raiz.addWidget(nota)
        self.refrescar()
        if cache().get("disponible"):
            self.ver_cambios()

    def refrescar(self):
        self.actual.setText(sal("leksso-actualizar", "version"))
        try:
            d = json.load(open("/var/lib/leksso/instalada.json", encoding="utf-8"))
            self.huella.setText("Firma comprobada ✓" if d.get("commit") and d.get("firma") else "")
            self.huella.setToolTip(f"Commit {d.get('commit', '')[:7]} · firma {d.get('firma', '')}" if d.get("commit") else "")
        except (OSError, ValueError):
            self.huella.setText("")
        texto_hw, hay_hw = resumen_hw(estado_hw())
        self.hw.setText(texto_hw)
        self.b_hw.setEnabled(hay_hw)
        c = cache()
        disp = c.get("disponible")
        self.b_instalar.setEnabled(bool(disp))
        previa = ""
        try:
            previa = open("/var/lib/leksso/version-anterior", encoding="utf-8").read().strip()
        except OSError:
            pass
        nombre = (sal("leksso-actualizar", "version", previa) or previa) if previa else ""
        self.b_volver.setEnabled(bool(previa))
        self.b_volver.setText(f"Volver a {nombre.replace('LeksSO ', '')}" if previa else "Volver a la anterior")
        self.b_volver.setToolTip("Reinstala la versión anterior y aparta lo que añadió la actual (queda en un respaldo). "
                                 "También se puede hacer al arrancar, con la entrada «LeksSO: volver a la versión anterior» del menú."
                                 if previa else "No hay una versión anterior guardada (se guarda al actualizar).")
        if disp:
            self.estado.setText(f"Hay una versión nueva: {sal('leksso-actualizar', 'version', disp) or disp}. Léela abajo y actualiza cuando quieras.")
        elif c.get("comprobado"):
            self.estado.setText("Estás al día.")
        else:
            self.estado.setText("Todavía no se ha comprobado. Pulsa «Buscar versión nueva».")

    def comprobar(self):
        self.b_comprobar.setEnabled(False)
        self.estado.setText("Buscando…")
        self.t = Trabajo(["leksso-actualizar", "comprobar"], "comprobar")
        self.t.listo.connect(self.fin)
        self.t.start()

    def ver_cambios(self):
        self.t2 = Trabajo(["leksso-actualizar", "cambios"], "cambios")
        self.t2.listo.connect(self.fin)
        self.t2.start()

    def fin(self, etiqueta, texto):
        if etiqueta == "comprobar":
            self.b_comprobar.setEnabled(True)
            self.refrescar()
            self.estado.setText(texto or self.estado.text())
            if cache().get("disponible"):
                self.ver_cambios()
        else:
            self.cambios.setMarkdown(texto)

    def terminal(self, titulo, orden):
        subprocess.Popen(["leksso-term", "-T", titulo, "-e", "sh", "-c",
                          orden + '; printf "\\n\\nPulsa Intro para cerrar."; read -r _'],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

    def instalar(self):
        self.terminal("Actualizar LeksSO", "sudo leksso-actualizar aplicar")

    def instalar_hw(self):
        est = estado_hw()
        n = est.get("nvidia") or {}
        if est.get("secure_boot") and n.get("accion") == "instalar" and clave_secure_boot() != "registrada":
            if confirmar(
                self, "Secure Boot",
                "Tu equipo tiene Secure Boot. Para usar el controlador de NVIDIA hay que registrar una clave de firma "
                "en este equipo, una sola vez. Se crea sola, con una contraseña corta que verás en pantalla: la "
                "escribirás en una pantalla azul al reiniciar, y después quedará guardada (oculta) en Ajustes → "
                "Secure Boot. Nada se instala hasta que termines ese paso.",
                    "Registrar la clave y seguir"):
                self.terminal("Sistema y controladores", "sudo leksso-actualizar hardware sistema --si-mok")
            return
        if confirmar(
            self, "Sistema y controladores",
            "Se abre una terminal que pide tu contraseña e instala las actualizaciones del sistema. Si hay controlador de "
            "NVIDIA o firmware de dispositivos, te preguntará antes: NVIDIA necesita reiniciar y el firmware no se puede "
            "deshacer (no apagues el equipo mientras se instala).",
                "Abrir la terminal e instalar"):
            self.terminal("Sistema y controladores", "sudo leksso-actualizar hardware sistema")

    def volver(self):
        if confirmar(self, "Volver a la versión anterior",
                                           "Se reinstala la versión anterior de LeksSO (con su firma comprobada, sin necesitar red) y se apartan a un respaldo "
                                           "los archivos que añadió la versión actual. Tus ajustes y tus archivos no se tocan.\n\n"
                                           "Si el escritorio no arrancara, también puedes hacerlo desde el menú de arranque: "
                                           "«LeksSO: volver a la versión anterior».",
                                           "Volver a la versión anterior", peligro=True):
            self.terminal("Volver a la versión anterior", "sudo leksso-actualizar volver")

    def keyPressEvent(self, ev):
        if ev.key() == QtCore.Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(ev)


def main():
    if alternar("leksso-actualizaciones"):
        return 0
    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-actualizaciones")
    w = Ventana()
    w.resize(620, 600)
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
