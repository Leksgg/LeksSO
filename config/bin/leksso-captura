#!/usr/bin/env bash
# Captura de pantalla: se guarda en ~/Imágenes/Capturas, se copia al portapapeles y avisa.
# Uso: leksso-captura region|pantalla|ventana
DIR="${XDG_PICTURES_DIR:-$HOME/Imágenes}/Capturas"
mkdir -p "$DIR"
ARCH="$DIR/captura-$(date +%Y%m%d-%H%M%S).png"
case "${1:-region}" in
  region)   AREA="$(slurp -b 15171acc -c 79b1e0ff -w 2)" || exit 0 ; grim -g "$AREA" "$ARCH" ;;
  pantalla) grim "$ARCH" ;;
  ventana)  AREA="$(swaymsg -t get_tree | python3 -c '
import json,sys
def f(n):
    if n.get("focused") and n.get("pid"): return n["rect"]
    for h in n.get("nodes",[])+n.get("floating_nodes",[]):
        r=f(h)
        if r: return r
r=f(json.load(sys.stdin))
print("%d,%d %dx%d"%(r["x"],r["y"],r["width"],r["height"]) if r else "")')"
            [ -n "$AREA" ] || { notify-send "Captura" "No hay ninguna ventana activa. Haz clic en la ventana y vuelve a probar."; exit 1; }
            grim -g "$AREA" "$ARCH" ;;
  *) echo "Uso: leksso-captura region|pantalla|ventana" >&2; exit 2 ;;
esac
wl-copy < "$ARCH"
notify-send -t 5000 "Captura guardada" "$(basename "$ARCH") (también está en el portapapeles)" -i "$ARCH"
