#!/usr/bin/env python3
"""Modo de energía para la barra de LeksSO: lo enseña y deja cambiarlo con un menú.

  leksso-barra-perfil          imprime el estado para la barra (icono y nombre del modo)
  leksso-barra-perfil menu     abre un menú con los tres modos y una línea que explica cada uno

Los tres modos son los de power-profiles-daemon (los mismos que en Energía y en Ajustes).
"""
import json
import shutil
import subprocess
import sys

# clave del sistema -> (nombre, icono de FontAwesome 4.7, clase CSS, qué hace)
MODOS = {
    "power-saver": ("Ahorro", "", "ahorro", "La batería dura más; el equipo va más lento y más fresco."),
    "balanced": ("Equilibrado", "", "equilibrado", "Rinde cuando hace falta y ahorra cuando no. El de uso normal."),
    "performance": ("Rendimiento", "", "rendimiento", "Todo al máximo. Gasta más batería y calienta más."),
}
ORDEN = ["power-saver", "balanced", "performance"]


def actual():
    try:
        r = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def estado():
    clave = actual()
    if clave not in MODOS:
        return {"text": ""}     # sin power-profiles-daemon: la barra oculta el módulo
    nombre, icono, clase, texto = MODOS[clave]
    return {"text": f"{icono} {nombre}", "class": clase, "tooltip": f"Modo de energía: {nombre}\n{texto}\nClic para cambiarlo."}


def linea(clave, marcado):
    nombre, _, _, texto = MODOS[clave]
    return f"{'✓' if marcado else ' '} {nombre}  ·  {texto}"


def poner(clave):
    subprocess.run(["powerprofilesctl", "set", clave], capture_output=True, timeout=5)
    subprocess.run(["pkill", "-RTMIN+10", "waybar"], capture_output=True)     # la barra se refresca al momento


def menu():
    ahora = actual()
    if ahora not in MODOS:
        return 1
    try:
        return ventana(ahora)
    except ImportError:
        return menu_fuzzel(ahora)


def ventana(ahora):
    """Ventanita con los tres modos: se cierra con la X, con Esc, al hacer clic fuera o al elegir uno."""
    sys.path.insert(0, "/usr/local/lib/leksso-ui")
    from PySide6 import QtCore, QtWidgets
    from leksso_ui import ESTILO_BASE, alternar, estilo, pintar

    if alternar("leksso-modo"):      # un segundo clic en la batería la cierra
        return 0

    class Modos(QtWidgets.QWidget):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("Modo de energía")
            estilo(self, ESTILO_BASE)
            raiz = QtWidgets.QVBoxLayout(self)
            raiz.setContentsMargins(14, 10, 14, 14)
            cab = QtWidgets.QHBoxLayout()
            t = QtWidgets.QLabel("Modo de energía")
            t.setObjectName("titulo")
            cab.addWidget(t)
            cab.addStretch()
            x = QtWidgets.QPushButton("✕")
            x.setObjectName("cerrar")
            x.setToolTip("Cerrar (Esc)")
            x.clicked.connect(self.close)
            cab.addWidget(x)
            raiz.addLayout(cab)
            for clave in ORDEN:
                nombre, icono, _, texto = MODOS[clave]
                b = QtWidgets.QPushButton(f"{icono}  {nombre}\n{texto}")
                b.setObjectName("accion")
                if clave == ahora:
                    b.setStyleSheet(pintar("background: #143c5b; color: #79b1e0; border: 1px solid #79b1e0;"))
                b.clicked.connect(lambda _=False, c=clave: self.elegir(c))
                raiz.addWidget(b)

        def elegir(self, clave):
            if clave != ahora:
                poner(clave)
            self.close()

        def keyPressEvent(self, ev):
            if ev.key() == QtCore.Qt.Key_Escape:
                self.close()
            else:
                super().keyPressEvent(ev)

        def changeEvent(self, ev):
            # al perder el foco (clic fuera) se cierra, salvo en el primer instante, cuando aún no lo había recibido
            if ev.type() == QtCore.QEvent.ActivationChange and self.tuvo_foco and not self.isActiveWindow():
                self.close()
            elif self.isActiveWindow():
                self.tuvo_foco = True
            super().changeEvent(ev)

        tuvo_foco = False

    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-modo")
    w = Modos()
    w.resize(400, 300)
    w.show()
    return app.exec()


def menu_fuzzel(ahora):
    if shutil.which("fuzzel") is None:
        # sin menú disponible: pasa al modo siguiente
        poner(ORDEN[(ORDEN.index(ahora) + 1) % len(ORDEN)])
        return 0
    lineas = "\n".join(linea(c, c == ahora) for c in ORDEN)
    r = subprocess.run(["fuzzel", "--dmenu", "--index", "--prompt", "Modo de energía: ", "--lines", "3", "--width", "66"],
                       input=lineas, capture_output=True, text=True)
    elegido = r.stdout.strip()
    if r.returncode == 0 and elegido.isdigit() and int(elegido) < len(ORDEN) and ORDEN[int(elegido)] != ahora:
        poner(ORDEN[int(elegido)])
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "menu":
        sys.exit(menu())
    print(json.dumps(estado(), ensure_ascii=False))
