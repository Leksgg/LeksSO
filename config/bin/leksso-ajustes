#!/usr/bin/env python3
"""Ajustes de LeksSO: un solo sitio para las cosas del sistema (sonido, red, pantallas...).

Cada botón abre la herramienta que ya existe para eso; aquí solo se reúnen.
Se cierra con la X o con Esc.
"""
import getpass
import os
import shutil
import subprocess
import sys

from PySide6 import QtCore, QtGui, QtWidgets

sys.path.insert(0, "/usr/local/lib/leksso-ui")
from leksso_ui import ESTILO_BASE, alternar, estilo, pedir_permiso, sudo_cmd  # noqa: E402

# (nombre, descripción, orden, programa que debe existir)
AJUSTES = [
    ("Sonido", "Salidas, entradas, volumen", ["pavucontrol-qt"], "pavucontrol-qt"),
    ("Red", "Cable y Wi-Fi", ["leksso-term", "-T", "Redes", "-e", "leksso-redes"], "nmtui"),
    ("Pantallas", "Resolución y escala", ["wdisplays"], "wdisplays"),
    ("Bluetooth", "Auriculares y mandos", ["blueman-manager"], "blueman-manager"),
    ("Apariencia", "Tema de color, letra, iconos", ["leksso-apariencia"], "leksso-apariencia"),
    ("Secure Boot", "Clave de firma de controladores", ["leksso-secureboot"], "leksso-secureboot"),
    ("Impresoras", "Añadir impresoras, también por wifi",
     ["sh", "-c", "command -v system-config-printer >/dev/null && exec system-config-printer || exec brave-browser http://localhost:631"],
     "cupsd"),
    ("Aplicaciones", "Instalar programas",
     ["leksso-term", "-T", "Aplicaciones", "-e", "sh", "-c", "leksso-apps; printf '\\nPulsa Intro para cerrar.'; read -r _"],
     "leksso-apps"),
    ("Zonas del escritorio", "Tus tamaños se guardan solos. Pulsa para volver a los de fábrica",
     ["leksso-zonas", "--fabrica"], "leksso-zonas"),
    ("Vista del escritorio", "Vuelve a la vista por defecto sin cerrar tus programas",
     ["leksso-zonas", "--restaurar"], "leksso-zonas"),
    ("Actualizaciones", "Versión y novedades", ["leksso-actualizaciones"], "leksso-actualizaciones"),
    ("Copias", "Copias de seguridad de tus archivos", ["leksso-copias-ui"], "leksso-copias-ui"),
    ("Acceso remoto (SSH)", "__SSH__", None, "leksso-acceso-remoto"),
    ("Bloqueo y reposo", "Cuándo se bloquea la pantalla, se apaga y se suspende", "__REPOSO__", "leksso-reposo"),
    ("Disco cifrado", "Pedir la clave al arrancar o desbloquear solo con el TPM", "__DISCO__", "leksso-disco"),
    ("Discos", "Ver discos y particiones, ampliar el sistema", "__DISCOS__", "lsblk"),
    ("Seguridad", "Qué se ha instalado y de dónde viene", ["leksso-seguridad"], "leksso-seguridad"),
    ("Archivos y papelera", "Recuperar lo borrado", ["pcmanfm-qt", "trash:///"], "pcmanfm-qt"),
]
PERFILES = [("Ahorro", "power-saver"), ("Equilibrado", "balanced"), ("Rendimiento", "performance")]


def estado_ssh():
    """'apagado', 'local' o 'publico'."""
    r = subprocess.run(["leksso-acceso-remoto", "estado"], capture_output=True, text=True)
    return r.stdout.strip() or "apagado"


def cuenta_ssh():
    """(tiene contraseña, nº de claves SSH autorizadas) de esta cuenta."""
    r = subprocess.run(["leksso-acceso-remoto", "cuenta"], capture_output=True, text=True).stdout
    datos = dict(x.split("=", 1) for x in r.split() if "=" in x)
    try:
        return datos.get("contrasena") == "si", int(datos.get("claves", "0"))
    except ValueError:
        return False, 0


def _aviso(parent, titulo, texto, icono=QtWidgets.QMessageBox.Information):
    m = QtWidgets.QMessageBox(icono, titulo, texto, QtWidgets.QMessageBox.Ok, parent)
    m.exec()


def poner_contrasena(parent):
    """Pone contraseña a la cuenta (se usará por SSH; el inicio de sesión y sudo siguen igual). True si se puso."""
    usuario = getpass.getuser()
    if not pedir_permiso(parent, "Para poner la contraseña hace falta permiso de administrador."):
        return False
    for _ in range(3):
        c1, ok = QtWidgets.QInputDialog.getText(
            parent, "Contraseña para SSH",
            "Esta contraseña solo se pedirá al entrar por SSH desde otro equipo. Tu inicio de sesión y sudo siguen sin pedirla.\n\n"
            "Elige una contraseña (mínimo 8 caracteres):", QtWidgets.QLineEdit.Password)
        if not ok:
            return False
        if len(c1) < 8 or c1.lower() == usuario.lower() or ":" in c1 or "\n" in c1:
            _aviso(parent, "Contraseña", "Debe tener al menos 8 caracteres, no ser tu nombre de usuario ni contener «:».")
            continue
        c2, ok = QtWidgets.QInputDialog.getText(parent, "Contraseña para SSH", "Repítela:", QtWidgets.QLineEdit.Password)
        if not ok:
            return False
        if c1 != c2:
            _aviso(parent, "Contraseña", "No coinciden. Prueba otra vez.")
            continue
        rc, _out, err = sudo_cmd(["chpasswd"], entrada=f"{usuario}:{c1}\n", espera=60)
        if rc == 0:
            return True
        _aviso(parent, "Contraseña", "No se pudo poner la contraseña:\n" + (err.strip() or "error desconocido"), QtWidgets.QMessageBox.Warning)
        return False
    return False


def autorizar_clave(parent):
    """Pide una clave pública y la autoriza para esta cuenta. True si quedó autorizada."""
    texto, ok = QtWidgets.QInputDialog.getMultiLineText(
        parent, "Autorizar clave",
        "Pega la clave PÚBLICA del equipo desde el que vas a entrar (una línea que empieza por ssh-ed25519 o ssh-rsa).\n"
        "La encuentras en ~/.ssh/id_ed25519.pub de ese equipo. Nunca pegues la clave privada.")
    if not ok or not texto.strip():
        return False
    r = subprocess.run(["leksso-acceso-remoto", "clave", texto.strip().splitlines()[0]], capture_output=True, text=True)
    if r.returncode != 0:
        _aviso(parent, "Autorizar clave", (r.stderr or r.stdout).strip() or "No se pudo autorizar la clave.", QtWidgets.QMessageBox.Warning)
        return False
    return True


def preparar_cuenta(parent, modo_publico=False):
    """Deja la cuenta lista para entrar por SSH: contraseña (solo red local) o clave. False si el usuario cancela."""
    con_pw, claves = cuenta_ssh()
    if modo_publico and claves == 0:
        _aviso(parent, "Acceso público", "El modo público solo admite clave SSH y esta cuenta no tiene ninguna autorizada. "
               "Autoriza primero la del equipo desde el que vas a entrar.")
        return autorizar_clave(parent)
    if con_pw or claves:
        return True
    caja = QtWidgets.QMessageBox(parent)
    caja.setWindowTitle("Acceso remoto (SSH)")
    caja.setText("Esta cuenta no tiene contraseña")
    caja.setInformativeText("Sin contraseña ni clave, nadie podría entrar por SSH. Elige cómo quieres entrar:\n\n"
                            "Contraseña para SSH: solo se pide al entrar por SSH; tu inicio de sesión no cambia.\n"
                            "Clave pública: la más segura; pegas la clave del equipo desde el que entrarás.")
    pw = caja.addButton("Poner contraseña para SSH", QtWidgets.QMessageBox.AcceptRole)
    clave = caja.addButton("Autorizar una clave", QtWidgets.QMessageBox.AcceptRole)
    caja.addButton("Cancelar", QtWidgets.QMessageBox.RejectRole)
    caja.exec()
    sel = caja.clickedButton()
    if sel is pw:
        return poner_contrasena(parent)
    if sel is clave:
        return autorizar_clave(parent)
    return False


TIEMPOS = [("Nunca", 0), ("1 minuto", 1), ("5 minutos", 5), ("10 minutos", 10), ("15 minutos", 15), ("30 minutos", 30),
           ("1 hora", 60), ("2 horas", 120)]


def tiempos_reposo():
    r = subprocess.run(["leksso-reposo", "mostrar"], capture_output=True, text=True).stdout
    datos = dict(x.split("=", 1) for x in r.split() if "=" in x)
    try:
        return {k: int(datos.get(k, d)) for k, d in (("bloqueo", 10), ("pantalla", 15), ("suspension", 30))}
    except ValueError:
        return {"bloqueo": 10, "pantalla": 15, "suspension": 30}


def dialogo_reposo(parent):
    """Cuándo se bloquea la pantalla, se apaga y se suspende por inactividad. Se guarda en ~/.config/leksso/reposo."""
    actual = tiempos_reposo()
    d = QtWidgets.QDialog(parent)
    d.setWindowTitle("Bloqueo y reposo")
    lay = QtWidgets.QVBoxLayout(d)
    lay.addWidget(QtWidgets.QLabel("Tiempo sin tocar el equipo hasta que ocurra cada cosa.\nLa suspensión solo se aplica con batería."))
    form = QtWidgets.QFormLayout()
    combos = {}
    for clave, texto in (("bloqueo", "Bloquear la pantalla"), ("pantalla", "Apagar la pantalla"), ("suspension", "Suspender el equipo")):
        c = QtWidgets.QComboBox()
        for nombre, minutos in TIEMPOS:
            c.addItem(nombre, minutos)
        i = c.findData(actual[clave])
        if i < 0:
            c.addItem(f"{actual[clave]} minutos", actual[clave])
            i = c.count() - 1
        c.setCurrentIndex(i)
        combos[clave] = c
        form.addRow(texto, c)
    lay.addLayout(form)
    botones = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Save | QtWidgets.QDialogButtonBox.Cancel)
    botones.accepted.connect(d.accept)
    botones.rejected.connect(d.reject)
    lay.addWidget(botones)
    if d.exec() != QtWidgets.QDialog.Accepted:
        return
    ruta = os.path.expanduser("~/.config/leksso/reposo")
    os.makedirs(os.path.dirname(ruta), exist_ok=True)
    with open(ruta + ".nuevo", "w", encoding="utf-8") as f:
        for clave, c in combos.items():
            f.write(f"{clave}={c.currentData()}\n")
    os.replace(ruta + ".nuevo", ruta)
    subprocess.Popen(["leksso-reposo", "aplicar"], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    _aviso(parent, "Bloqueo y reposo", "Guardado. Ya está en uso.")


def dialogo_discos(parent):
    """Discos y particiones: tabla de lectura, salud y accesos a las herramientas de edición."""
    r = subprocess.run(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS"], capture_output=True, text=True)
    caja = QtWidgets.QDialog(parent)
    caja.setWindowTitle("Discos")
    caja.resize(760, 520)
    v = QtWidgets.QVBoxLayout(caja)
    cab = QtWidgets.QHBoxLayout()
    titulo = QtWidgets.QLabel("Discos")
    titulo.setObjectName("titulo")
    cab.addWidget(titulo)
    cab.addStretch()
    x = QtWidgets.QPushButton("✕")
    x.setObjectName("cerrar")
    x.setToolTip("Cerrar (Esc)")
    x.clicked.connect(caja.reject)
    cab.addWidget(x)
    v.addLayout(cab)
    t = QtWidgets.QPlainTextEdit(r.stdout or "No se pudo leer la lista de discos.")
    t.setReadOnly(True)
    t.setLineWrapMode(QtWidgets.QPlainTextEdit.NoWrap)
    t.setFont(QtGui.QFontDatabase.systemFont(QtGui.QFontDatabase.FixedFont))
    v.addWidget(t)
    nota = QtWidgets.QLabel(
        "Para discos de datos (USB, un segundo disco) usa GParted o Discos. El disco del sistema está dentro de un "
        "contenedor cifrado: crece desde aquí («Ampliar el sistema»); reducirlo o moverlo exige hacerlo con el sistema "
        "apagado.")
    nota.setWordWrap(True)
    v.addWidget(nota)
    fila = QtWidgets.QHBoxLayout()

    def lanzar(orden):
        subprocess.Popen(orden, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def boton(texto, orden, hay):
        b = QtWidgets.QPushButton(texto)
        b.setEnabled(hay)
        if not hay:
            b.setToolTip("No está instalado (Aplicaciones, Utilidades)")
        b.clicked.connect(lambda _=False: lanzar(orden))
        fila.addWidget(b)
    boton("GParted", ["pkexec", "gparted"], shutil.which("gparted") is not None)
    boton("Discos de GNOME", ["gnome-disks"], shutil.which("gnome-disks") is not None)
    term = ["leksso-term", "-T", "Discos", "-e", "sh", "-c"]
    boton("Salud (SMART)", term + ["sudo smartctl -H -A $(lsblk -dno PATH -e7 | head -1) | head -40; printf '\\nPulsa Intro para cerrar.'; read -r _"],
          shutil.which("smartctl") is not None)
    boton("Ampliar el sistema", term + ["sudo leksso-disco ampliar; printf '\\nPulsa Intro para cerrar.'; read -r _"],
          shutil.which("leksso-disco") is not None)
    v.addLayout(fila)
    caja.exec()


def dialogo_disco(parent):
    """Disco cifrado: pedir la clave al arrancar o desbloquearlo solo con el TPM. Se hace en una terminal (pide la clave
    del disco una vez para autorizar el cambio)."""
    r = subprocess.run(["leksso-disco", "estado", "--corto"], capture_output=True, text=True)
    modo = r.stdout.strip() or "no se pudo leer"
    if modo == "sin disco cifrado":
        _aviso(parent, "Disco cifrado", "Este equipo no tiene el disco cifrado.")
        return
    caja = QtWidgets.QMessageBox(parent)
    caja.setWindowTitle("Disco cifrado")
    caja.setText("Ahora: " + modo)
    caja.setInformativeText(
        "Desbloqueo automático: el equipo abre el disco solo con su TPM; no hay que teclear la clave al arrancar. "
        "Protege el disco si lo sacan o se llevan el equipo y lo abren en otro. NO protege contra quien encienda este "
        "equipo tal cual: llegará al escritorio sin clave.\n\n"
        "Pedir clave al arrancar: la más segura; la clave se teclea en cada arranque.\n\n"
        "Tu clave del disco no se borra nunca: es el respaldo. Si cambia la BIOS o las claves de arranque, el equipo "
        "la pedirá una vez y se renueva con «sudo leksso-disco renovar».")
    auto = caja.addButton("Desbloqueo automático", QtWidgets.QMessageBox.AcceptRole)
    clave = caja.addButton("Pedir clave al arrancar", QtWidgets.QMessageBox.AcceptRole)
    caja.addButton("Cancelar", QtWidgets.QMessageBox.RejectRole)
    caja.exec()
    sel = caja.clickedButton()
    if sel is auto:
        accion = "on"
    elif sel is clave:
        accion = "off"
    else:
        return
    subprocess.Popen(["leksso-term", "-T", "Disco cifrado", "-e", "sh", "-c",
                      f"sudo leksso-disco automatico {accion}; printf '\\nPulsa Intro para cerrar.'; read -r _"],
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def orden_ssh(parent):
    """Pregunta qué modo de SSH quiere y devuelve la orden (en una terminal, que pide la contraseña y enseña el
    progreso), o None si cancela."""
    actual = estado_ssh()
    caja = QtWidgets.QMessageBox(parent)
    caja.setWindowTitle("Acceso remoto (SSH)")
    caja.setText("Acceso remoto por SSH")
    caja.setInformativeText(
        "Ahora: " + {"apagado": "apagado", "local": "encendido solo en la red local",
                     "publico": "encendido local y público"}[actual] + ".\n\n"
        "Red local: entras desde tu casa o tu red, con usuario y contraseña o con clave.\n\n"
        "Local y público: entras también desde internet (por ejemplo desde un servidor). Solo con clave SSH, sin "
        "contraseña; hace falta tener una clave autorizada y reenviar el puerto 22 en el router.")
    local = caja.addButton("Solo red local", QtWidgets.QMessageBox.AcceptRole)
    publico = caja.addButton("Local y público", QtWidgets.QMessageBox.AcceptRole)
    apagar = caja.addButton("Apagar", QtWidgets.QMessageBox.DestructiveRole)
    caja.addButton("Cancelar", QtWidgets.QMessageBox.RejectRole)
    caja.exec()
    sel = caja.clickedButton()
    if sel is apagar:
        accion = "off"
    elif sel is local:
        if not preparar_cuenta(parent):
            return None
        accion = "on local"
    elif sel is publico:
        if not preparar_cuenta(parent, modo_publico=True):
            return None
        accion = "on publico"
    else:
        return None
    return ["leksso-term", "-T", "Acceso remoto", "-e", "sh", "-c",
            f"sudo leksso-acceso-remoto {accion}; printf '\\nPulsa Intro para cerrar.'; read -r _"]


def info():
    def sal(*c):
        return subprocess.run(c, capture_output=True, text=True).stdout.strip()
    mem = sal("sh", "-c", "free -m | awk 'NR==2{printf \"%d MB de %d MB en uso\", $3, $2}'")
    disco = sal("sh", "-c", "df -h / | awk 'NR==2{print $3\" de \"$2\" en uso\"}'")
    return (f"{sal('leksso-actualizar', 'version')} (sobre Debian {sal('cat', '/etc/debian_version')})\nNúcleo: {sal('uname', '-r')}\n"
            f"Memoria: {mem}\nDisco: {disco}\nEquipo: {sal('hostname')}")


class Tarjeta(QtWidgets.QPushButton):
    """Botón de ajuste: título y descripción en etiquetas que se ajustan al ancho, para que nunca queden cortadas."""
    ALTO = 96

    def __init__(self, nombre, desc):
        super().__init__()
        self.setObjectName("accion")
        self.setMinimumHeight(self.ALTO)
        self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Preferred)
        lay = QtWidgets.QVBoxLayout(self)
        lay.setContentsMargins(14, 10, 14, 10)
        lay.setSpacing(4)
        t = QtWidgets.QLabel(nombre)
        t.setStyleSheet("background: transparent; font-weight: bold;")
        d = QtWidgets.QLabel(desc)
        d.setObjectName("nota")
        d.setWordWrap(True)
        d.setStyleSheet("background: transparent;")
        for e in (t, d):
            e.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents)   # el clic llega al botón
        lay.addWidget(t)
        lay.addWidget(d)
        lay.addStretch()


class Ajustes(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Ajustes")
        estilo(self, ESTILO_BASE)
        externo = QtWidgets.QVBoxLayout(self)
        externo.setContentsMargins(0, 0, 0, 0)
        # Todo el contenido va en un área con barra de desplazamiento: si la pantalla es pequeña, nada queda cortado.
        area = QtWidgets.QScrollArea()
        area.setWidgetResizable(True)
        area.setFrameShape(QtWidgets.QFrame.NoFrame)
        area.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarAlwaysOff)
        externo.addWidget(area)
        contenido = QtWidgets.QWidget()
        area.setWidget(contenido)
        raiz = QtWidgets.QVBoxLayout(contenido)
        raiz.setContentsMargins(14, 10, 14, 14)
        cab = QtWidgets.QHBoxLayout()
        t = QtWidgets.QLabel("Ajustes")
        t.setObjectName("titulo")
        cab.addWidget(t)
        cab.addStretch()
        x = QtWidgets.QPushButton("✕")
        x.setObjectName("cerrar")
        x.setToolTip("Cerrar (Esc)")
        x.clicked.connect(self.close)
        cab.addWidget(x)
        raiz.addLayout(cab)
        self.rejilla = QtWidgets.QGridLayout()
        rejilla = self.rejilla
        rejilla.setSpacing(10)
        self.tarjetas = []
        self.columnas = 0
        for nombre, desc, orden, prog in AJUSTES:
            ssh = desc == "__SSH__"
            if ssh:
                desc = {"apagado": "Apagado. Pulsa para encenderlo (red local o también público)",
                        "local": "Encendido solo en la red local. Pulsa para cambiarlo",
                        "publico": "Encendido local y público (con clave). Pulsa para cambiarlo"}[estado_ssh()]
            b = Tarjeta(nombre, desc)
            ok = shutil.which(prog) is not None or prog == "cupsd"
            b.setEnabled(ok)
            if not ok:
                b.setToolTip("No está instalado")
            if orden == "__REPOSO__":
                b.clicked.connect(lambda _=False: dialogo_reposo(self))
            elif orden == "__DISCO__":
                b.clicked.connect(lambda _=False: dialogo_disco(self))
            elif orden == "__DISCOS__":
                b.clicked.connect(lambda _=False: dialogo_discos(self))
            else:
                b.clicked.connect(lambda _=False, o=orden, e=ssh: self.abrir(orden_ssh(self) if e else o))
            self.tarjetas.append(b)
        raiz.addLayout(rejilla)
        self.colocar(2)
        if shutil.which("powerprofilesctl"):
            raiz.addWidget(QtWidgets.QLabel("Modo de energía"))
            fila = QtWidgets.QHBoxLayout()
            actual = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True).stdout.strip()
            for texto, clave in PERFILES:
                b = QtWidgets.QPushButton(("● " if clave == actual else "") + texto)
                b.setObjectName("accion")
                b.clicked.connect(lambda _=False, c=clave: (subprocess.run(["powerprofilesctl", "set", c]), self.close()))
                fila.addWidget(b)
            raiz.addLayout(fila)
        sobre = QtWidgets.QLabel(info())
        sobre.setObjectName("nota")
        sobre.setTextInteractionFlags(QtCore.Qt.TextSelectableByMouse)
        raiz.addWidget(sobre)
        raiz.addStretch()

    def colocar(self, columnas):
        """Reparte las tarjetas en `columnas` columnas (se rehace al cambiar el ancho de la ventana)."""
        if columnas == self.columnas:
            return
        self.columnas = columnas
        for b in self.tarjetas:
            self.rejilla.removeWidget(b)
        for i, b in enumerate(self.tarjetas):
            self.rejilla.addWidget(b, i // columnas, i % columnas)
        for c in range(4):
            self.rejilla.setColumnStretch(c, 1 if c < columnas else 0)

    def resizeEvent(self, ev):
        super().resizeEvent(ev)
        # una columna cada ~340 px: 1 en pantallas estrechas, hasta 3 en las anchas
        self.colocar(max(1, min(3, self.width() // 340)))

    def abrir(self, orden):
        if orden is None:      # el usuario canceló el diálogo
            return
        subprocess.Popen(orden, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

    def keyPressEvent(self, ev):
        if ev.key() == QtCore.Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(ev)


def main():
    if alternar("leksso-ajustes"):
        return 0
    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-ajustes")
    w = Ajustes()
    # Tamaño según la pantalla: ancho del 55 % (entre 720 y 1000 px) y alto del 80 %, sin pasar nunca de la pantalla.
    # Lo que no quepa se ve con la barra de desplazamiento; las columnas de botones se adaptan al ancho.
    disp = app.primaryScreen().availableGeometry()
    ancho = max(720, min(1000, int(disp.width() * 0.55)))
    alto = max(560, min(900, int(disp.height() * 0.8)))
    w.resize(min(ancho, disp.width() - 40), min(alto, disp.height() - 40))
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
