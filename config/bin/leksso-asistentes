#!/usr/bin/env python3
"""Asistentes de IA de LeksSO: cuáles usas y qué puede hacer cada uno en tu equipo.

  leksso-asistentes              abre la ventana de ajustes
  leksso-asistentes abrir [NOMBRE]   abre ese asistente; sin nombre, el único activo (o la ventana si hay varios o ninguno)
  leksso-asistentes estado       lista los asistentes y sus permisos
  sudo leksso-asistentes aplicar ARCHIVO.json    guarda los permisos (lo usa la ventana; pide tu contraseña)

Cada asistente tiene sus propios permisos. Puedes tener varios activos a la vez, cada uno en su ventana.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, "/usr/local/lib/leksso-ia")
import asistentes  # noqa: E402

PROGRAMA = {"claude": "claude", "codex": "codex"}
PAQUETE = {"claude": "@anthropic-ai/claude-code", "codex": "@openai/codex"}


def usuario():
    import pwd
    return pwd.getpwuid(os.getuid()).pw_name


def instalado(n):
    return shutil.which(PROGRAMA[n]) is not None


def lanzar(n):
    """Cada asistente en su propia ventana de terminal, en la zona del panel de la IA."""
    titulo = f"Asistente · {asistentes.NOMBRES[n]}"
    fin = 'printf "\\n\\nSesion terminada. Pulsa Intro para cerrar esta ventana.\\n"; read -r _'
    try:      # la zona del panel de la IA solo existe mientras haya un asistente: se crea al abrir el primero
        subprocess.run(["leksso-zonas", "--zona-ia", "--auto"], timeout=20, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass
    subprocess.Popen(["leksso-term", "-T", titulo, "--app-id", f"leksso-asistente-{n}", "-e", "sh", "-c",
                      f"leksso-{n}; {fin}"], start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def aplicar(ruta):
    if os.getuid() != 0:
        sys.exit("Hace falta ser administrador: sudo leksso-asistentes aplicar ARCHIVO")
    quien = os.environ.get("SUDO_USER") or ""
    if not quien or quien == "root":
        sys.exit("Ejecuta con sudo desde tu usuario.")
    with open(ruta, encoding="utf-8") as f:
        nuevos = json.load(f)
    asistentes.guardar(quien, nuevos)
    for n, p in asistentes.leer(quien).items():
        print(f"  {asistentes.NOMBRES[n]:<8} {'activo' if p['activo'] else 'apagado':<8} {asistentes.resumen(p)}")
    print("Permisos guardados. Se aplican a partir de la próxima orden del asistente.")


def estado():
    for n, p in asistentes.leer(usuario()).items():
        marca = ("activo" if p["activo"] else "apagado") + ("" if instalado(n) else " · sin instalar")
        print(f"  {n:<7} {asistentes.NOMBRES[n]:<8} {marca:<24} {asistentes.resumen(p)}")


def ventana():
    from PySide6 import QtCore, QtWidgets
    sys.path.insert(0, "/usr/local/lib/leksso-ui")
    from leksso_ui import ESTILO_BASE, alternar, estilo
    if alternar("leksso-asistentes"):
        return 0

    class Fila(QtWidgets.QGroupBox):
        def __init__(self, n, p):
            super().__init__(asistentes.NOMBRES[n] + ("" if instalado(n) else "  (sin instalar: se instala al abrirlo)"))
            self.n = n
            self.original = p                       # por si los permisos guardados no encajan en ningún nivel
            v = QtWidgets.QVBoxLayout(self)
            arriba = QtWidgets.QHBoxLayout()
            self.activo = QtWidgets.QCheckBox("Usar este asistente")
            self.activo.setChecked(p["activo"])
            arriba.addWidget(self.activo)
            arriba.addStretch()
            self.abrir = QtWidgets.QPushButton("Abrir")
            self.abrir.setObjectName("accion")
            arriba.addWidget(self.abrir)
            v.addLayout(arriba)
            niv = QtWidgets.QHBoxLayout()
            niv.addWidget(QtWidgets.QLabel("Nivel:"))
            self.nivel = QtWidgets.QComboBox()
            for clave, texto in asistentes.NOMBRE_PREAJUSTE.items():
                self.nivel.addItem(f"{list(asistentes.NOMBRE_PREAJUSTE).index(clave) + 1}. {texto}", clave)
            actual = next((c for c, val in asistentes.PREAJUSTES.items()
                           if all(p[k] == x for k, x in val.items())), None)
            if actual is None:                      # permisos sueltos de una versión antigua: se enseñan tal cual
                self.nivel.addItem("Personalizado (" + asistentes.resumen(p) + ")", None)
                actual = None
            self.nivel.setCurrentIndex(max(self.nivel.findData(actual), 0))
            niv.addWidget(self.nivel)
            niv.addStretch()
            v.addLayout(niv)
            self.aviso = QtWidgets.QLabel("")
            self.aviso.setWordWrap(True)
            self.aviso.setMinimumHeight(66)
            self.aviso.setAlignment(QtCore.Qt.AlignTop | QtCore.Qt.AlignLeft)
            v.addWidget(self.aviso)
            self.nivel.currentIndexChanged.connect(self.coherencia)
            self.coherencia()

        def poner(self, p):
            self.nivel.setCurrentIndex(max(self.nivel.findData(next(
                (c for c, val in asistentes.PREAJUSTES.items() if all(p[k] == x for k, x in val.items())), None)), 0))
            self.coherencia()

        def coherencia(self):
            clave = self.nivel.currentData()
            if clave is None:
                self.aviso.setText("Permisos de una versión anterior que no son ninguno de los cinco niveles. "
                                   "Elige un nivel para sustituirlos.")
            else:
                self.aviso.setText(asistentes.DESCRIPCION_PREAJUSTE[clave])

        def valor(self):
            clave = self.nivel.currentData()
            base = dict(asistentes.PREAJUSTES[clave]) if clave else {k: self.original[k] for k in ("archivos", "comandos", "admin")}
            return dict(base, activo=self.activo.isChecked())

    class V(QtWidgets.QWidget):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("Asistentes de IA")
            estilo(self, ESTILO_BASE + """
                QCheckBox { spacing: 10px; }
                QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #7f8f91; background: #021012; }
                QCheckBox::indicator:hover { border-color: #00c4bf; }
                QCheckBox::indicator:checked { background: #00c4bf; border-color: #00c4bf; }
                QCheckBox::indicator:disabled { border-color: #25393c; background: #25393c; }
                QCheckBox::indicator:checked:disabled { background: #15827f; border-color: #15827f; }
                QGroupBox { border: 1px solid #25393c; margin-top: 18px; padding: 10px 8px 8px 8px; font-weight: bold; }
                QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #00c4bf; }
            """)
            raiz = QtWidgets.QVBoxLayout(self)
            raiz.setContentsMargins(14, 10, 14, 14)
            cab = QtWidgets.QHBoxLayout()
            t = QtWidgets.QLabel("Asistentes de IA")
            t.setObjectName("titulo")
            cab.addWidget(t)
            cab.addStretch()
            x = QtWidgets.QPushButton("✕")
            x.setObjectName("cerrar")
            x.clicked.connect(self.close)
            cab.addWidget(x)
            raiz.addLayout(cab)
            intro = QtWidgets.QLabel("Elige cuáles usas y qué puede hacer cada uno. Puedes tener varios a la vez.")
            intro.setWordWrap(True)
            raiz.addWidget(intro)
            self.guardados = asistentes.leer(usuario())
            self.filas = {}
            for n, p in self.guardados.items():
                f = Fila(n, p)
                f.abrir.clicked.connect(lambda _=False, nombre=n: self.abrir(nombre))
                self.filas[n] = f
                raiz.addWidget(f)
            raiz.addStretch()
            pie = QtWidgets.QHBoxLayout()
            self.estado = QtWidgets.QLabel("")
            pie.addWidget(self.estado)
            pie.addStretch()
            g = QtWidgets.QPushButton("Guardar cambios")
            g.setObjectName("accion")
            g.clicked.connect(self.guardar)
            pie.addWidget(g)
            raiz.addLayout(pie)

        def actual(self):
            return {n: asistentes.validar(f.valor()) for n, f in self.filas.items()}

        def guardar(self):
            nuevos = self.actual()
            if nuevos == asistentes.leer(usuario()):
                self.estado.setText("No hay cambios.")
                return True
            fd, ruta = tempfile.mkstemp(prefix="leksso-asistentes-", suffix=".json")
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(nuevos, f)
            orden = (f"echo 'Guardar los permisos de los asistentes necesita tu contraseña.'; "
                     f"sudo leksso-asistentes aplicar {ruta}; rm -f {ruta}; "
                     "printf '\\nPulsa Intro para cerrar.'; read -r _")
            subprocess.Popen(["leksso-term", "-T", "Guardar permisos", "-e", "sh", "-c", orden], start_new_session=True)
            self.estado.setText("Confirma con tu contraseña en la ventana que se ha abierto.")
            return False

        def abrir(self, n):
            if self.actual() != asistentes.leer(usuario()):
                self.estado.setText("Guarda los cambios antes de abrirlo.")
                return
            if not self.filas[n].activo.isChecked():
                self.estado.setText(f"Marca «Usar este asistente» en {asistentes.NOMBRES[n]} y guarda.")
                return
            lanzar(n)
            self.close()

        def keyPressEvent(self, ev):
            if ev.key() == QtCore.Qt.Key_Escape:
                self.close()
            else:
                super().keyPressEvent(ev)

    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-asistentes")
    w = V()
    w.resize(560, 640)
    w.show()
    return app.exec()


def abrir(nombre=None):
    activos = [n for n, p in asistentes.leer(usuario()).items() if p["activo"]]
    if nombre:
        if nombre not in asistentes.NOMBRES:
            sys.exit(f"No conozco «{nombre}». Disponibles: {', '.join(asistentes.NOMBRES)}")
        if nombre not in activos:
            sys.exit(f"{asistentes.NOMBRES[nombre]} está apagado. Actívalo en la ventana de asistentes (leksso-asistentes).")
        lanzar(nombre)
        return 0
    if len(activos) == 1:
        lanzar(activos[0])
        return 0
    return ventana()


def main(a):
    if not a:
        return ventana()
    if a[0] == "abrir":
        return abrir(a[1] if len(a) > 1 else None)
    if a[0] == "estado":
        return estado()
    if a[0] == "aplicar" and len(a) == 2:
        return aplicar(a[1])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
