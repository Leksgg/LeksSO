#!/usr/bin/env python3
"""Energía de LeksSO: bloquear, suspender, hibernar, cerrar sesión, reiniciar y apagar.

Solo muestra activas las opciones que el equipo admite (por ejemplo, hibernar necesita
espacio de intercambio). Las que cierran lo que estás haciendo piden confirmación.
Se cierra con la X, con Esc o al elegir una opción.
"""
import subprocess
import sys

from PySide6 import QtCore, QtWidgets

sys.path.insert(0, "/usr/local/lib/leksso-ui")
from leksso_ui import ESTILO_BASE, alternar, confirmar, estilo, pedir_permiso, pintar, sudo_cmd  # noqa: E402


def admite(metodo):
    """Pregunta a logind si el equipo puede hacerlo (yes / challenge = sí)."""
    r = subprocess.run(
        ["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
         "org.freedesktop.login1.Manager", metodo],
        capture_output=True, text=True)
    return r.returncode == 0 and ('"yes"' in r.stdout or '"challenge"' in r.stdout)


# (texto, descripción, orden, método de logind o None, pide confirmación, peligro)
ACCIONES = [
    ("Bloquear", "Pide la contraseña para volver", ["leksso-bloquear"], None, False, False),
    ("Suspender", "Pausa el equipo y gasta muy poco", ["systemctl", "suspend"], "CanSuspend", False, False),
    ("Hibernar", "Guarda todo en el disco y apaga", ["systemctl", "hibernate"], "CanHibernate", True, False),
    ("Cerrar sesión", "Cierra tus programas y vuelve al inicio", ["swaymsg", "exit"], None, True, False),
    ("Reiniciar", "Apaga y vuelve a encender", ["systemctl", "reboot"], "CanReboot", True, True),
    ("Apagar", "Apaga el equipo", ["systemctl", "poweroff"], "CanPowerOff", True, True),
]


# (clave del sistema, texto, qué hace)
PERFILES = [
    ("power-saver", "Ahorro", "Ahorro: la batería dura más; el equipo va más lento y más fresco."),
    ("balanced", "Equilibrado", "Equilibrado: rinde cuando hace falta y ahorra cuando no. El de uso normal."),
    ("performance", "Rendimiento", "Rendimiento: todo al máximo. Gasta más batería y calienta más."),
]


class Energia(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Energía")
        estilo(self, ESTILO_BASE)
        raiz = QtWidgets.QVBoxLayout(self)
        raiz.setContentsMargins(14, 10, 14, 14)
        cab = QtWidgets.QHBoxLayout()
        t = QtWidgets.QLabel("Energía")
        t.setObjectName("titulo")
        cab.addWidget(t)
        cab.addStretch()
        x = QtWidgets.QPushButton("✕")
        x.setObjectName("cerrar")
        x.setToolTip("Cerrar (Esc)")
        x.clicked.connect(self.close)
        cab.addWidget(x)
        raiz.addLayout(cab)
        # Perfil de energía: cuánto rinde y cuánto gasta el equipo. Solo si el equipo lo admite.
        self.perfiles = {}
        actual = self.perfil_actual()
        if actual:
            raiz.addWidget(QtWidgets.QLabel("Perfil de energía"))
            fila = QtWidgets.QHBoxLayout()
            for clave, texto, ayuda in PERFILES:
                b = QtWidgets.QPushButton(texto)
                b.setCheckable(True)
                b.setToolTip(ayuda)
                b.clicked.connect(lambda _=False, c=clave: self.poner_perfil(c))
                self.perfiles[clave] = b
                fila.addWidget(b)
            raiz.addLayout(fila)
            self.nota_perfil = QtWidgets.QLabel("")
            self.nota_perfil.setWordWrap(True)
            raiz.addWidget(self.nota_perfil)
            self.marcar_perfil(actual)
        for nombre, desc, orden, metodo, confirma, peligro in ACCIONES:
            ok = metodo is None or admite(metodo)
            b = QtWidgets.QPushButton(f"{nombre}\n{desc}" if ok else f"{nombre}\nNo disponible en este equipo")
            b.setObjectName("peligro" if peligro else "accion")
            b.setEnabled(ok)
            b.clicked.connect(lambda _=False, n=nombre, o=orden, c=confirma: self.hacer(n, o, c))
            raiz.addWidget(b)
        # «Reiniciar desde un dispositivo» de Windows: arrancar una sola vez otro sistema, una memoria USB o la BIOS.
        otro = QtWidgets.QPushButton("Reiniciar en otro sistema…\nWindows, USB de arranque o BIOS")
        otro.setObjectName("peligro")
        otro.clicked.connect(self.reiniciar_en)
        raiz.addWidget(otro)
        raiz.addStretch()

    def reiniciar_en(self):
        """Elegir a dónde reiniciar UNA vez. La lista sale de las entradas de arranque que ve la BIOS."""
        r = subprocess.run(["leksso-reiniciar-en", "listar"], capture_output=True, text=True)
        etiqueta = {"usb": "Memoria USB", "windows": "Windows", "red": "Arranque por red", "sistema": "Sistema"}
        opciones = []     # (texto, id o None para la BIOS)
        for linea in r.stdout.splitlines():
            partes = linea.split("\t")
            if len(partes) == 3:
                nombre = partes[2].strip()
                if nombre.lower() == "debian":
                    nombre = "LeksSO"
                opciones.append((f"{etiqueta.get(partes[1], 'Sistema')}: {nombre}", partes[0]))
        opciones.sort(key=lambda o: (o[0].startswith("Arranque por red"), o[0]))   # la red, al final
        opciones.append(("Configuración de la BIOS", None))
        texto, ok = QtWidgets.QInputDialog.getItem(
            self, "Reiniciar en…", "Elige a dónde quieres arrancar esta vez. Después el equipo arrancará como siempre.",
            [o[0] for o in opciones], 0, False)
        if not ok:
            return
        id_entrada = dict(opciones)[texto]
        if not confirmar(
                self, "Reiniciar", f"Se reiniciará ahora en:\n{texto}\n\nSe cerrará lo que tengas abierto sin guardar.",
                "Reiniciar ahora"):
            return
        if id_entrada is None:
            self.hacer("Reiniciar en la BIOS", ["leksso-reiniciar-en", "bios"], False)
            return
        if not pedir_permiso(self, "Para elegir el arranque de la próxima vez hace falta permiso de administrador."):
            return
        rc, _salida, err = sudo_cmd(["efibootmgr", "--bootnext", id_entrada], espera=30)
        if rc != 0:
            QtWidgets.QMessageBox.warning(self, "Reiniciar", "No se pudo preparar el arranque:\n" + (err.strip() or "error desconocido"))
            return
        self.hacer("Reiniciar", ["systemctl", "reboot"], False)

    @staticmethod
    def perfil_actual():
        try:
            r = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            return ""
        return r.stdout.strip() if r.returncode == 0 else ""

    def marcar_perfil(self, actual):
        for clave, b in self.perfiles.items():
            b.setChecked(clave == actual)
            b.setStyleSheet(pintar("background: #003635; color: #00c4bf; border: 1px solid #00c4bf;") if clave == actual else "")
        self.nota_perfil.setText(next((ayuda for clave, _, ayuda in PERFILES if clave == actual), ""))

    def poner_perfil(self, clave):
        subprocess.run(["powerprofilesctl", "set", clave], capture_output=True, timeout=5)
        self.marcar_perfil(self.perfil_actual())
        subprocess.run(["pkill", "-RTMIN+10", "waybar"], capture_output=True)

    def hacer(self, nombre, orden, confirma):
        if confirma:
            if not confirmar(self, nombre, "Se cerrará lo que tengas abierto sin guardar.", nombre):
                return
        self.hide()
        subprocess.Popen(orden, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        QtCore.QTimer.singleShot(300, self.close)

    def keyPressEvent(self, ev):
        if ev.key() == QtCore.Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(ev)


def main():
    if alternar("leksso-energia"):
        return 0
    app = QtWidgets.QApplication(sys.argv)
    app.setDesktopFileName("leksso-energia")
    w = Energia()
    w.resize(380, 580)
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
