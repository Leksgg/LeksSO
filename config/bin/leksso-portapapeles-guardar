#!/usr/bin/env python3
"""Guarda en el historial lo que copias, SIN lo que no debe guardarse, y borra lo viejo.

  wl-paste --type text  --watch leksso-portapapeles-guardar guardar     (lo lanza la sesión; recibe lo copiado por la entrada)
  leksso-portapapeles-guardar caducar                                   (la sesión lo repite cada 10 minutos)

Hallazgo 17 de la revisión de la 0.1.52: cliphist guardaba en disco todo lo copiado (texto e imágenes) y para siempre, así
que las contraseñas copiadas quedaban en el historial. Ahora:
  - Lo que un gestor de contraseñas marca como sensible NO se guarda: el tipo «x-kde-passwordManagerHint» (KeePassXC,
    Bitwarden y otros) o CLIPBOARD_STATE=sensitive/clear (wl-clipboard 2.2 o más nuevo).
  - Lo demás caduca: por defecto a las 2 horas (cambia el tiempo en la ventana del portapapeles; 0 = nunca). cliphist no
    anota la hora, así que aquí se guarda aparte (~/.cache/leksso, solo del usuario) cuándo apareció cada entrada.
Solo biblioteca estándar y nada de Qt: arranca en unos 30 ms por cada cosa que se copia.
"""
import json
import os
import subprocess
import sys
import tempfile
import time

CADUCA_POR_DEFECTO = 120                     # minutos
MAX_BYTES = 8 * 1024 * 1024                   # lo más grande que se guarda de una vez
TIPO_SENSIBLE = "x-kde-passwordmanagerhint"   # lo que ponen los gestores de contraseñas (sin distinguir mayúsculas)


def ruta_config():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "leksso", "portapapeles")


def ruta_tiempos():
    return os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "leksso", "portapapeles-tiempos.json")


def minutos_de_caducidad():
    """Minutos que dura lo copiado; 0 = no caduca. Lo que no se entienda vuelve al valor por defecto."""
    try:
        with open(ruta_config(), encoding="utf-8") as f:
            for linea in f:
                k, _, v = linea.partition("=")
                if k.strip() == "caduca_min" and v.strip().isdigit():
                    return min(int(v.strip()), 60 * 24 * 365)
    except OSError:
        pass
    return CADUCA_POR_DEFECTO


def es_sensible(entorno, tipos):
    """¿Lo copiado viene de un gestor de contraseñas (o lo anuncia como sensible)?"""
    if (entorno.get("CLIPBOARD_STATE") or "").lower() in ("sensitive", "clear"):
        return True
    return any(t.strip().lower() == TIPO_SENSIBLE for t in tipos)


def tipos_ofrecidos():
    try:
        r = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return []
    return r.stdout.split() if r.returncode == 0 else []


def ids_actuales():
    """Los identificadores del historial, el más reciente primero."""
    try:
        r = subprocess.run(["cliphist", "list"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    ids = []
    for linea in r.stdout.splitlines():
        ident = linea.partition("\t")[0]
        if ident.isdigit():
            ids.append(ident)
    return ids


def leer_tiempos():
    try:
        with open(ruta_tiempos(), encoding="utf-8") as f:
            d = json.load(f)
        return {k: float(v) for k, v in d.items()} if isinstance(d, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def guardar_tiempos(d):
    ruta = ruta_tiempos()
    os.makedirs(os.path.dirname(ruta), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(ruta), prefix=".tiempos")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(d, f)
    os.replace(tmp, ruta)                      # mkstemp ya lo crea con permisos 0600


def borrar(ids):
    """Quita esas entradas del historial (cliphist delete lee líneas que empiezan por el identificador)."""
    if ids:
        subprocess.run(["cliphist", "delete"], input="".join(f"{i}\t\n" for i in ids), text=True, capture_output=True, timeout=30)


def caducar(ahora=None):
    """Borra las entradas más viejas que la caducidad y tira del archivo de horas lo que ya no existe."""
    ahora = ahora or time.time()
    tiempos = leer_tiempos()
    vivos = ids_actuales()
    nuevos = {i: tiempos.get(i, ahora) for i in vivos}          # lo que aún no tenía hora empieza a contar ahora
    limite = minutos_de_caducidad() * 60
    viejos = [i for i, t in nuevos.items() if limite and ahora - t > limite]
    borrar(viejos)
    guardar_tiempos({i: t for i, t in nuevos.items() if i not in viejos})
    return viejos


def guardar(datos, entorno=None, ahora=None):
    """Guarda lo copiado salvo que sea sensible. Devuelve True si se guardó."""
    entorno = os.environ if entorno is None else entorno
    if not datos or len(datos) > MAX_BYTES:
        return False
    if es_sensible(entorno, tipos_ofrecidos()):
        return False
    subprocess.run(["cliphist", "store"], input=datos, capture_output=True, timeout=30)
    ids = ids_actuales()
    if ids:
        tiempos = leer_tiempos()
        tiempos[ids[0]] = ahora or time.time()
        guardar_tiempos(tiempos)
    caducar(ahora)
    return True


def main(a):
    if a[:1] == ["guardar"]:
        guardar(sys.stdin.buffer.read(MAX_BYTES + 1))
        return 0
    if a[:1] == ["caducar"]:
        caducar()
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
