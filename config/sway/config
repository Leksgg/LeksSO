# LeksSO sobre sway: escritorio por zonas.
# Raíl de iconos a la izquierda | explorador | centro (la app activa, a pantalla completa de su zona,
# con terminal debajo) | panel de la IA a la derecha. Barra de tareas abajo.
# Las zonas las monta leksso-zonas al iniciar.

set $mod Mod4
set $term leksso-term
set $menu leksso-menu

default_border pixel 1
# El foco del teclado va a la ventana donde haces clic, no a donde se queda el ratón
focus_follows_mouse no
titlebar_border_thickness 0
# Las marcas ([centro], [panel-ia]) son internas: no se enseñan en los títulos.
show_marks no
titlebar_padding 8 4
font pango:DejaVu Sans 11
workspace_layout default

# Colores (misma paleta que la barra): una sola pestaña activa en cian, el resto apagado.
#                         borde    fondo    texto    indicador  borde hijo
client.focused            #00c4bf  #003635  #e3edef  #00c4bf    #00c4bf
client.focused_inactive   #25393c  #112123  #94a1a3  #25393c    #25393c
client.unfocused          #25393c  #09191b  #94a1a3  #25393c    #25393c
client.urgent             #fdc357  #332305  #fdc357  #fdc357    #fdc357

output * bg #021012 solid_color
gaps inner 0

# Los servicios de usuario (portales, avisos...) necesitan ver la pantalla de esta sesión: sin esto, un portal
# (p. ej. el de GTK que instalan algunos programas) no arranca, el portal principal se queda esperando y la barra muere.
# La barra espera a que el entorno esté pasado.
exec sh -c 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway 2>/dev/null; exec leksso-barra'
exec systemctl --user start leksso-permisor.service
exec leksso-zonas
exec leksso-actualizar comprobar --avisar
exec mako
exec lxqt-policykit-agent
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# Reposo: por defecto bloquear a los 10 min, apagar la pantalla a los 15 y suspender a los 30 (solo con batería).
# Los tiempos se cambian en Ajustes, Bloqueo y reposo (se guardan en ~/.config/leksso/reposo).
exec leksso-reposo iniciar
exec leksso-disco primer-arranque
exec leksso-hora
exec udiskie --no-tray --no-notify --automount

# El menú de aplicaciones flota en el centro de la pantalla
for_window [app_id="leksso-menu"] floating enable, resize set 480 620, move position center
# El asistente de IA se acopla como pestaña en la zona de la derecha
for_window [app_id="^leksso-asistente-"] move container to mark panel-ia, focus
for_window [app_id="^leksso-asistente$"] move container to mark panel-ia, focus
for_window [app_id="leksso-asistentes"] floating enable
for_window [app_id="leksso-energia"] floating enable, resize set 380 680, move position center
for_window [app_id="leksso-modo"] floating enable, resize set 400 300, move position center
for_window [app_id="leksso-calendario"] floating enable, resize set 380 520, move position center
for_window [app_id="leksso-dispositivos"] floating enable, resize set 420 520, move position center
for_window [app_id="leksso-notificaciones"] floating enable, resize set 460 520, move position center
for_window [app_id="leksso-portapapeles"] floating enable, resize set 520 560, move position center
for_window [app_id="leksso-ajustes"] floating enable, resize set 600 540, move position center
for_window [app_id="leksso-actualizaciones"] floating enable, resize set 620 520, move position center

# Atajos básicos (Mod = tecla Windows)
bindsym $mod+Return exec leksso-term -T Terminal
bindsym $mod+d exec $menu
bindsym $mod+e exec leksso-zonas --plegar
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+a exec leksso-panel-ia

# Cambiar de app en el centro
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym Mod1+Tab focus next
bindsym $mod+f fullscreen toggle
bindsym $mod+m exec leksso-flotantes

# Mover el foco entre zonas con las flechas
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Pantalla completa (vídeo, juegos, directos) no deja que el equipo se bloquee
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# Teclas de volumen, micrófono, brillo y multimedia (también con la pantalla bloqueada)
bindsym --locked XF86AudioRaiseVolume exec leksso-medios volumen-subir
bindsym --locked XF86AudioLowerVolume exec leksso-medios volumen-bajar
bindsym --locked XF86AudioMute exec leksso-medios volumen-silencio
bindsym --locked XF86AudioMicMute exec leksso-medios micro-silencio
bindsym --locked XF86MonBrightnessUp exec leksso-medios brillo-subir
bindsym --locked XF86MonBrightnessDown exec leksso-medios brillo-bajar
bindsym --locked XF86AudioPlay exec leksso-medios play
bindsym --locked XF86AudioNext exec leksso-medios siguiente
bindsym --locked XF86AudioPrev exec leksso-medios anterior

# Capturas, portapapeles y ajustes
bindsym Print exec leksso-captura region
bindsym Shift+Print exec leksso-captura pantalla
bindsym $mod+Print exec leksso-captura ventana
bindsym $mod+v exec leksso-portapapeles
bindsym $mod+i exec leksso-ajustes
bindsym $mod+l exec swaylock -f

# Ajustes locales de este equipo (por ejemplo, la resolución en una máquina virtual).
include ~/.config/sway/local.conf
