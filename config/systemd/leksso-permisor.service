[Unit]
Description=Permisor de IA de LeksSO

[Service]
Type=simple
# -I: modo aislado. Sin él Python carga los paquetes y los archivos .pth de ~/.local, y cualquier proceso del usuario
# (también uno lanzado por un asistente) podía meter código dentro del permisor y hacerse pasar por él ante root.
ExecStart=/usr/bin/python3 -I /usr/local/lib/leksso-ia/permisor.py
# Cada pocos segundos (y en cada orden) deja la cabeza del registro en el diario del sistema, que el usuario no puede reescribir.
Environment=LEKSSO_SELLO=syslog
Restart=on-failure
RestartSec=2

# Confinamiento que un servicio de usuario puede aplicar sin privilegios (filtro de llamadas al sistema).
# Las opciones de aislamiento de montajes (ProtectSystem, PrivateTmp, PrivateNetwork...) fallan en un
# servicio de usuario; el aislamiento del sistema lo da la caja.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @module @reboot @swap @raw-io @cpu-emulation @obsolete
UMask=0077
