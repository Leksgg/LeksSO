# Al iniciar sesión en la primera consola, arranca el escritorio de LeksSO (sway).
# Con el controlador propietario de NVIDIA, sway solo arranca si se le dice que acepta la tarjeta.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$(tty)" = "/dev/tty1" ]; then
  if grep -q '^nvidia ' /proc/modules 2>/dev/null; then
    exec sway --unsupported-gpu
  fi
  exec sway
fi
[ -f ~/.bashrc ] && . ~/.bashrc
