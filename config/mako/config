# Notificaciones de LeksSO: paleta propia, esquina superior derecha.
font=Raxtor,DejaVu Sans 11
background-color=#112123f2
text-color=#e3edef
border-color=#00c4bf
border-size=1
border-radius=0
progress-color=over #003635
padding=12
margin=14
width=360
height=140
anchor=top-right
layer=overlay
default-timeout=6000
icons=1
max-icon-size=40
max-history=50

[urgency=low]
border-color=#25393c
default-timeout=3000

[urgency=critical]
border-color=#ff735a
default-timeout=0

[app-name=leksso-actualizar]
border-color=#fdc357
on-button-left=exec leksso-actualizaciones

[app-name=leksso-ia]
border-color=#fdc357
background-color=#2d1f05f2
on-button-left=exec leksso-panel-ia

# «No molestar» (botón de Notificaciones): los avisos no salen en pantalla pero quedan en el historial
[mode=silencio]
invisible=1
